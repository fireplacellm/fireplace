<?xml version="1.0" encoding="utf-8"?>
<!--
  Offline guarantee (ADR 0003): the ONLY network permission is INTERNET, used
  solely by the first-run setup downloader (data/Downloader.kt) to fetch the
  model + optional knowledge-pack upgrade. Inference, retrieval and all data
  import make NO network calls - put the phone in airplane mode after setup and
  everything still works. scripts/verify_offline.sh (run in CI) fails the build
  if any network API appears outside Downloader.kt, or if a broader network
  permission is declared.

  Deliberately ABSENT (would widen the surface, not needed): ACCESS_NETWORK_STATE,
  ACCESS_WIFI_STATE, CHANGE_NETWORK_STATE, CHANGE_WIFI_STATE, ACCESS_*_LOCATION,
  RECORD_AUDIO, CAMERA.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET is used ONLY to download the model + knowledge pack during
         first-run setup. Inference and all data import are 100% offline; put the
         phone in airplane mode after setup and everything still works. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The setup download runs in a foreground service so a multi-GB model keeps
         downloading with the screen off / app backgrounded (dataSync type). The
         notification permission lets us show the progress bar on Android 13+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Reading model/pack files the user placed in shared storage (scoped). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Optional: biometric app lock. No network, no location, no audio by default. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".FireplaceApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Fireplace"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fireplace"
        android:usesCleartextTraffic="false"
        android:memtagMode="sync">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Fireplace"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground service for the one-time setup download (model + pack). -->
        <service
            android:name=".data.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
